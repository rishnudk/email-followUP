# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=email_followup
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_followup?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API & Web App Configuration
PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# Security & Encryption (AES-256 key must be exactly 32 bytes/characters)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"
SESSION_SECRET="super-secret-session-cookie-secret-key-at-least-32-chars"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"
