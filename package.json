{
  "name": "email-followup-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@email-followup/api",
    "dev:web": "npm run dev --workspace=@email-followup/web",
    "build": "npm run build --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace=@email-followup/api",
    "db:migrate": "npm run db:migrate --workspace=@email-followup/api",
    "db:studio": "npm run db:studio --workspace=@email-followup/api"
  }
}
